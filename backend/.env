# Database
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/trs_db

# JWT
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=trs-imports-media

# Option 1: Resend.com (Recommended - 100% Free & No Google Password Needed!)
# Sign up on https://resend.com, generate an API Key, and paste below:
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=onboarding@resend.dev
FROM_NAME=TRS Products

# Option 2: Brevo / SendGrid API (Alternative)
BREVO_API_KEY=your-brevo-api-key
SENDGRID_API_KEY=your-sendgrid-api-key

# Option 3: Gmail SMTP (Requires App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_SSL=false
FROM_EMAIL=your-email@gmail.com

# PayHere
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret
PAYHERE_SANDBOX=true
PAYHERE_API_URL=https://sandbox.payhere.lk/pay/checkout

# App
APP_NAME=TRS Products
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Admin
ADMIN_EMAIL=admin@trsimports.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=TRS Admin

# WhatsApp
WHATSAPP_NUMBER=94742975043

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000