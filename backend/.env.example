# TRS Imports - Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/trs_db

# JWT
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=trs-imports-media

# Email Configuration
# Option 1: Gmail SMTP (Recommended - Free & Easy)
# Step 1: Go to Google Account -> Security -> 2-Step Verification -> App passwords
# Step 2: Create an App Password for "Mail" and use it below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_TLS=true
SMTP_SSL=false
FROM_EMAIL=your-email@gmail.com
FROM_NAME=TRS Imports

# Option 2: SendGrid API (Alternative)
SENDGRID_API_KEY=your-sendgrid-api-key

# PayHere (Sri Lanka)
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret
PAYHERE_SANDBOX=true
PAYHERE_API_URL=https://sandbox.payhere.lk/pay/checkout

# App
APP_NAME=TRS Imports
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Admin default credentials (for seeding)
ADMIN_EMAIL=admin@trsimports.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=TRS Admin

# WhatsApp
WHATSAPP_NUMBER=94742975043

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
